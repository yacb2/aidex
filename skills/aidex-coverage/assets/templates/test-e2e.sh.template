#!/usr/bin/env bash
# =============================================================================
# E2E test runner (isolated environment) -- {{project_kebab}}
# =============================================================================
# Generated by aidex-coverage/scripts/gen-test-e2e.sh from .context/testing-profile.md.
# Regenerate with --force after changing the profile; do not hand-edit values here.
#
# Isolated: database {{project_slug}}_e2e (cloned from {{project_slug}}_e2e_template),
# backend :{{e2e_backend_port}} (dev :{{dev_backend_port}}), frontend :{{e2e_frontend_port}}
# (dev :{{dev_frontend_port}}). There is no dev-mode Playwright config.
#
# Usage:
#   ./test-e2e.sh e2e/foo.spec.ts       # one spec (the usual invocation)
#   ./test-e2e.sh --grep "creates"      # any playwright-test argument is forwarded
#   ./test-e2e.sh                       # whole suite (integration boundary only)
#   ./test-e2e.sh --setup-template      # build/rebuild the template DB
#   ./test-e2e.sh --ui | --stop | --help
# =============================================================================
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

# A worktree writes its own .env (ports, credentials); it must win over the
# defaults below, or an isolated run silently drives dev's database.
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    set -a; . "$PROJECT_ROOT/.env"; set +a
fi

DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-{{db_port}}}"
DB_USER="${DB_USER:-{{db_user}}}"
DB_PASSWORD="${{{db_password_env}}:-}"   # checked by need_password, so --help/--stop work without it
DB_TEMPLATE="{{project_slug}}_e2e_template"
DB_E2E="{{project_slug}}_e2e"
E2E_SERVICE="{{e2e_service}}"
E2E_FRONTEND_PORT="${E2E_FRONTEND_PORT:-{{e2e_frontend_port}}}"
E2E_BACKEND_PORT="${E2E_BACKEND_PORT:-{{e2e_backend_port}}}"

# Read by playwright.e2e.config.ts, test-config.ts and global-setup.ts.
export E2E_DB_PORT="$DB_PORT"
export E2E_FRONTEND_URL="http://localhost:${E2E_FRONTEND_PORT}"
export E2E_API_BASE="http://localhost:${E2E_BACKEND_PORT}/api/v1"
export E2E_BACKEND_URL="http://localhost:${E2E_BACKEND_PORT}"
export WORKSPACE_ROOT="$PROJECT_ROOT"
# COMPOSE_PROJECT_NAME is deliberately NOT set here: the worktree owns it.

info() { printf '  %s\n' "$*"; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need_password() { [[ -n "$DB_PASSWORD" ]] || die "{{db_password_env}} is not set (export it or put it in .env)"; }

psql_cmd() {
    PGPASSWORD="$DB_PASSWORD" psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d postgres "$@"
}

manage_in_template() {
    docker compose run --rm \
        -e DB_NAME="$DB_TEMPLATE" -e DB_USER="$DB_USER" -e DB_PASSWORD="$DB_PASSWORD" \
        -e DB_HOST=db -e DB_PORT=5432 \
        -e DJANGO_SETTINGS_MODULE=config.settings.test_e2e \
        backend python manage.py "$@"
}

setup_template() {
    need_password
    info "Setting up template database ${DB_TEMPLATE}"
    docker compose up -d db
    for _ in $(seq 1 30); do
        psql_cmd -c "SELECT 1" >/dev/null 2>&1 && break
        sleep 1
    done
    psql_cmd -c "SELECT 1" >/dev/null 2>&1 || die "database not reachable on ${DB_HOST}:${DB_PORT}"

    psql_cmd -c "UPDATE pg_database SET datistemplate=false WHERE datname='${DB_TEMPLATE}'" >/dev/null 2>&1 || true
    for db in "$DB_TEMPLATE" "$DB_E2E"; do
        psql_cmd -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='${db}' AND pid <> pg_backend_pid()" >/dev/null 2>&1 || true
        psql_cmd -c "DROP DATABASE IF EXISTS ${db}" >/dev/null
    done
    psql_cmd -c "CREATE DATABASE ${DB_TEMPLATE} OWNER ${DB_USER}" >/dev/null

    info "migrate"
    manage_in_template migrate --no-input
    info "{{seed_bootstrap_cmd}}"
    manage_in_template {{seed_bootstrap_cmd}}
    info "{{seed_e2e_bootstrap_cmd}}"
    manage_in_template {{seed_e2e_bootstrap_cmd}} --verbose

    psql_cmd -c "UPDATE pg_database SET datistemplate=true WHERE datname='${DB_TEMPLATE}'" >/dev/null
    info "Template ${DB_TEMPLATE} ready. Run: ./test-e2e.sh e2e/<spec>.spec.ts"
}

stop_e2e() {
    docker compose --profile e2e stop "$E2E_SERVICE" 2>/dev/null || true
    docker compose --profile e2e rm -f "$E2E_SERVICE" 2>/dev/null || true
    local vite_pid
    vite_pid="$(lsof -ti :"$E2E_FRONTEND_PORT" 2>/dev/null || true)"
    [[ -n "$vite_pid" ]] && kill $vite_pid 2>/dev/null || true
    info "E2E services stopped"
}

run_tests() {
    need_password
    export E2E_DB_PASSWORD="$DB_PASSWORD"   # global-setup.ts clones the template with psql
    info "frontend ${E2E_FRONTEND_URL}  backend ${E2E_BACKEND_URL}  db ${DB_E2E}@${DB_HOST}:${DB_PORT}"
    cd "$PROJECT_ROOT/frontend"
    [[ -d node_modules ]] || pnpm install
    pnpm exec playwright test --config=playwright.e2e.config.ts "$@"
}

show_help() {
    sed -n '/^# Usage:/,/^# ====/p' "$0" | sed 's/^# \{0,1\}//' | sed '$d'
}

case "${1:-}" in
    --setup-template) setup_template ;;
    --stop)           stop_e2e ;;
    --ui)             shift; run_tests --ui "$@" ;;
    --help|-h)        show_help ;;
    *)                run_tests "$@" ;;
esac

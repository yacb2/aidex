# Worktree profile — Django + Vue + Docker Compose (dashboard_template family)
#
# Copy to <project>/.context/worktrees/config.env and fill the three PROJECT
# lines. Everything else is the family default and should not need touching.
#
# This file is the ONLY project-specific part of the worktree mechanism. The
# mechanism itself is shipped by the skill (aidex-worktree/scripts/worktree.sh),
# which is the whole point: when the skill only *described* a recipe, all 15
# projects in the workspace implemented it differently and all 15 shipped a
# stack that could not run a second copy of itself.
#
# Validated end-to-end 2026-07-25 on a disposable copy of a real project in this
# family: 24.8s to create a fully isolated worktree (2 git repos, built image,
# network, volume, db + backend, ~190 migrations), 3.0s to tear down, zero
# residue verified against a global Docker snapshot, two created concurrently
# without collision.

# --- PROJECT: the repos that can participate in a worktree ------------------
WT_PARTICIPANTS="backend frontend"

# --- PROJECT: unversioned root-wrapper paths to symlink into the worktree ---
# In this family the root has no .git, so a fresh checkout of `backend/` alone
# lacks the compose file, the Dockerfile context and the gitignored .env.
# Relative paths are mirrored, so `backend/.env` lands at <worktree>/backend/.env.
WT_LINKS="docker-compose.yml dev.sh test-e2e.sh .docker backend/.env"

# --- PROJECT: port bases. Pick a free 4-digit band for THIS project ---------
# Two rules, both enforced by worktree.sh at startup rather than left to care:
#   1. WT_PORT_STRIDE must EXCEED the span between the lowest and highest base.
#      Otherwise slot N reuses a port from slot N-1's block. With bases spread
#      across 4400..4610 and a stride of 100, slot 1's DB_PORT landed exactly on
#      dev's BACKEND_PORT — a structural fault that merely looked like a busy
#      slot, because the allocator skipped past it.
#   2. Keep the bases in a NARROW window and let the stride separate the slots.
#      One block per slot is far easier to reason about than one band per role.
WT_PORT_VARS="DB_PORT=4400 BACKEND_PORT=4401 E2E_BACKEND_PORT=4402 DEMO_PORT=4403 FRONTEND_PORT=4404 E2E_FRONTEND_PORT=4405"
WT_PORT_STRIDE=10
WT_MAX_SLOTS=9

# --- family defaults --------------------------------------------------------
# Services the isolated stack starts. qcluster/worker/backend-test stay out of
# the default set: they are started on demand by their own profiles.
WT_SERVICES="db backend"

# The variable the compose file interpolates into every container_name, so a
# second stack does not collide on a name. Compose files in this family must
# carry `container_name: <name>${WT_SUFFIX:-}` — verify with
# `check-compose-isolation.sh` before trusting this profile.
WT_SUFFIX_VAR="WT_SUFFIX"

# Ready when the isolated Postgres answers over TCP. Deliberately NOT the unix
# socket: on a first run the entrypoint runs initdb and starts a temporary
# server that answers on the socket only, so a socket probe passes against a
# server that is about to shut down and the seed then dies mid-connection.
WT_READY_CMD='docker compose exec -T db psql -h 127.0.0.1 -U ${DB_USER:-postgres} -d ${DB_NAME:-postgres} -tAc "select 1"'

# Migrations, not a dump of dev. A schema-only start is seconds; cloning dev's
# data is minutes and couples every worktree to whatever dev happens to hold.
# Projects that genuinely need dev's data can append a pg_dump pipe here.
WT_SEED_CMD='docker compose exec -T backend python manage.py migrate --no-input'

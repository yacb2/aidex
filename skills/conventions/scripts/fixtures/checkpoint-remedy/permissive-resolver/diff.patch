+func Resolve(cfg Config, spec string) (Target, error) {
+	for _, skill := range cfg.Skills {
+		if skill.Name == spec || skill.Path == spec || filepath.Base(skill.Path) == spec {
+			return Target{Kind: KindSkill, Skill: skill}, nil
+		}
+	}
+	if strings.HasPrefix(spec, "skills/") && strings.HasSuffix(spec, ".md") {
+		return Target{Kind: KindSkill, Skill: Skill{Path: spec}}, nil
+	}
+	for _, file := range cfg.MemoryFiles {
+		if file == spec || filepath.Base(file) == spec {
+			return Target{Kind: KindMemory, File: file}, nil
+		}
+	}
+	if _, err := os.Stat(spec); err == nil {
+		return Target{Kind: KindMemory, File: spec}, nil
+	}
+	return Target{}, fmt.Errorf("unknown target %q", spec)
+}
